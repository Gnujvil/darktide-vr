<Window x:Class="DarktideVR.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DarktideVR.Launcher"
        Title="Darktide VR Launcher"
        Width="760" Height="680" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:SetupRow}">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="22" Height="22" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
                        <Ellipse x:Name="Dot" Fill="{StaticResource Muted}" />
                        <TextBlock x:Name="Glyph" Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{StaticResource Bg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextDim}"
                                   TextWrapping="Wrap" Margin="0,1,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource Small}" Content="{Binding ActionLabel}" Tag="{Binding}"
                            Click="RowAction_Click" VerticalAlignment="Center" Margin="12,0,0,0"
                            Visibility="{Binding ActionVisibility}" IsEnabled="{Binding ActionEnabled}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Ok">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Good}" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warn">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Amber}" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Bad}" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE711;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Busy">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE895;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Background="{StaticResource TitleBar}">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="18" Height="18" Margin="0,0,10,0" />
                    <TextBlock x:Name="TitleText" Text="Darktide VR Launcher" FontSize="13" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" />
                    <Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- Update banner -->
            <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource AmberFill}"
                    BorderBrush="{StaticResource AmberStroke}" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource Amber}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock x:Name="BannerText" Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="BannerButton" Grid.Column="2" Style="{StaticResource Primary}" Padding="16,6"
                            Content="Update now" Click="Banner_Click" Margin="12,0,0,0" />
                </Grid>
            </Border>

            <!-- Header -->
            <Grid Grid.Row="2" Margin="24,14,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="HeaderTitle" Text="Darktide VR" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource TextDim}">
                        <Run x:Name="HeaderVersions" Text="" />
                        <Run x:Name="NotesSeparator" Text="" />
                        <Hyperlink x:Name="NotesLink" Click="Notes_Click" Foreground="{StaticResource Amber}"><Run x:Name="NotesText" Text="" /></Hyperlink>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                        CornerRadius="7" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabSetup" Style="{StaticResource Tab}" Content="Setup" IsChecked="True" GroupName="Tabs" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabLog" Style="{StaticResource Tab}" Content="Log" GroupName="Tabs" Checked="Tab_Checked" Margin="3,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Setup list / log -->
            <Grid Grid.Row="3" Margin="24,0,24,0">
                <ScrollViewer x:Name="SetupView" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RowList" ItemTemplate="{StaticResource RowTemplate}" />
                </ScrollViewer>
                <Grid x:Name="LogView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="OpenLogButton" Style="{StaticResource Small}" Content="Open log folder" Click="OpenLog_Click" />
                        <Button x:Name="SupportZipButton" Style="{StaticResource Small}" Content="Create support zip" Click="SupportZip_Click" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="4" Background="{StaticResource TitleBar}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0"
                    Margin="0,10,0,0" Padding="24,10,24,14">
                <StackPanel>
                    <ProgressBar x:Name="Progress" Style="{StaticResource Thin}" Minimum="0" Maximum="100" Visibility="Hidden" Margin="0,0,0,10" />
                    <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,10" MinHeight="17" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="RefreshButton" Style="{StaticResource Ghost}" Content="Refresh" Click="Refresh_Click" />
                            <Button x:Name="UninstallButton" Style="{StaticResource Ghost}" Content="Uninstall…" Click="Uninstall_Click" />
                            <CheckBox x:Name="TestBuildsBox" Content="Include test builds" Margin="10,0,0,0" Click="TestBuilds_Click" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="PlayFlatButton" Style="{StaticResource Secondary}" Content="Play flat" Click="PlayFlat_Click" Padding="20,10" />
                            <Button x:Name="PlayVrButton" Style="{StaticResource Primary}" Content="Play in VR" Click="PlayVr_Click" Padding="28,10" Margin="10,0,0,0" FontSize="14" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
